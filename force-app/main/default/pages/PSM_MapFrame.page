<apex:page controller="PSM_MapController" showHeader="false" sidebar="false"
  standardStylesheets="false" docType="html-5.0" cache="false">
  <html lang="en">
    <head>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>Shape Map</title>
      <style type="text/css">
        html, body { height: 100%; margin: 0; padding: 0; overflow: hidden; }
        #map { height: 100vh; width: 100%; }
        #top-ui-shell {
          position: absolute;
          z-index: 11;
          top: 0;
          left: 0;
          right: 0;
          pointer-events: none;
          padding:
            calc(env(safe-area-inset-top, 0px) + 8px)
            calc(env(safe-area-inset-right, 0px) + 8px)
            0
            calc(env(safe-area-inset-left, 0px) + 8px);
          box-sizing: border-box;
        }
        #top-ui-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(280px, 420px) minmax(0, 1fr);
          align-items: start;
          gap: 10px;
        }
        #top-left-col,
        #top-center-col,
        #top-right-col {
          min-width: 0;
          pointer-events: auto;
        }
        #top-left-col { justify-self: start; }
        #top-center-col {
          justify-self: center;
          width: 100%;
        }
        #top-right-col { justify-self: end; }
        #gpm-search-container {
          margin-top: 8px;
          background: rgba(255, 255, 255, 0.96);
          border: 1px solid rgba(0, 0, 0, 0.08);
          border-radius: 12px;
          box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
          padding: 6px;
          width: 100%;
          box-sizing: border-box;
        }
        .gpm-search-box {
          display: flex;
          align-items: center;
          gap: 6px;
          min-width: 0;
        }
        #gpm-search-input {
          flex: 1 1 auto;
          min-width: 0;
          height: 42px;
          padding: 0 14px;
          border: 1px solid #d7dce2;
          border-radius: 10px;
          outline: none;
          font-size: 14px;
          background: #fff;
          color: #1f2933;
          box-sizing: border-box;
        }
        #gpm-search-button {
          flex: 0 0 auto;
          white-space: nowrap;
          padding: 0 16px;
          height: 42px;
          background: #2563eb;
          color: #fff;
          border: 1px solid #2563eb;
          border-radius: 10px;
          cursor: pointer;
          font-size: 14px;
          font-weight: 600;
          transition: background 0.2s;
        }
        #gpm-search-button:hover {
          background: #1d4ed8;
        }
        .pac-container {
          z-index: 2147483647 !important;
          font-family: Roboto, Arial, sans-serif;
        }
        .banner {
          margin-top: 6px;
          padding: 8px 12px;
          background: #f4f6f9;
          border: 1px solid #dddbda;
          border-radius: 8px;
          font-size: 13px;
          color: #3e3e3c;
        }
        #zoom-toast {
          position: fixed;
          left: 50%;
          bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
          transform: translateX(-50%);
          z-index: 120000;
          background: rgba(15, 23, 42, 0.97);
          color: #F8FAFC;
          border: 1px solid rgba(251, 191, 36, 0.95);
          padding: 10px 14px;
          border-radius: 10px;
          font-family: system-ui, sans-serif;
          font-size: 14px;
          font-weight: 700;
          letter-spacing: 0.01em;
          box-shadow: 0 10px 28px rgba(0,0,0,0.35);
          display: none;
          pointer-events: none;
          max-width: calc(100vw - 24px);
          text-align: center;
        }
        #zoom-toast.show {
          display: block;
        }
        #debug-stats {
          background: rgba(17,24,39,0.9);
          color: #F9FAFB; padding: 6px 10px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 12px; border-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.2);
          white-space: nowrap;
        }
        #show-all-shapes-wrap {
          margin-top: 6px;
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: rgba(17,24,39,0.9);
          color: #F9FAFB;
          padding: 6px 10px;
          border-radius: 4px;
          box-shadow: 0 1px 4px rgba(0,0,0,0.2);
          font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 12px;
          user-select: none;
        }
        #show-all-shapes-toggle {
          margin: 0;
          width: 14px;
          height: 14px;
        }
        #debug-zoom {
          background: rgba(17,24,39,0.9);
          color: #F9FAFB; padding: 6px 10px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 12px; border-radius: 4px; box-shadow: 0 1px 4px rgba(0,0,0,0.2);
          white-space: nowrap;
        }
        @media (max-width: 860px) {
          #top-ui-row {
            grid-template-columns: 1fr;
          }
          #top-left-col,
          #top-right-col,
          #top-center-col {
            justify-self: center;
          }
          .gpm-search-box {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
          }
          #gpm-search-button {
            width: 100%;
          }
        }
      </style>
      <apex:includeScript value="https://maps.googleapis.com/maps/api/js?key={!googleApiKey}&amp;libraries=geometry,places"/>
    </head>
    <body>
      <div id="top-ui-shell">
        <div id="top-ui-row">
          <div id="top-left-col">
            <div id="debug-stats">Visible Shapes: 0 | Available Shapes: 0</div>
            <label id="show-all-shapes-wrap" for="show-all-shapes-toggle">
              <input id="show-all-shapes-toggle" type="checkbox"/>
              <span>Show All Shapes</span>
            </label>
          </div>
          <div id="top-center-col">
            <div id="gpm-search-container">
              <div class="gpm-search-box">
                <input id="gpm-search-input" type="text" placeholder="Enter address or place..."/>
                <button id="gpm-search-button" type="button">Search</button>
              </div>
              <div id="gpm-client-error" class="banner" style="display: none"></div>
            </div>
            <div id="zoom-toast">Zoom in to load shapes.</div>
          </div>
          <div id="top-right-col">
            <div id="debug-zoom">Zoom: --</div>
          </div>
        </div>
      </div>
      <div id="map"></div>
      <script type="text/javascript">
        //<![CDATA[
        (function () {
          var map = null;
          var labelMarkers = [];
          var loadedShapeIds = {};
          var pendingShapeIds = {};
          var viewportDebounceTimer = null;
          var viewportRequestSeq = 0;
          var latestViewportRequestSeq = 0;
          var MIN_SHAPE_ZOOM = (function () {
            var parsed = Number({!minZoom});
            if (!isFinite(parsed) || parsed <= 0) {
              return 8;
            }
            return Math.floor(parsed);
          })();
          // Batch mode is currently disabled by default because large dissolved
          // geometries can exceed CPU in a single Apex transaction.
          var USE_BATCH_DISSOLVE = false;
          var BATCH_SIZE = 6;
          var BATCH_WORKERS = 2;
          var LEGACY_WORKERS = 2;
          var showAllShapes = false;
          var hoverFeature = null;

          function setDebugZoom(zoomLevel) {
            var el = document.getElementById('debug-zoom');
            if (!el) { return; }
            var z = (zoomLevel === null || zoomLevel === undefined || !isFinite(zoomLevel)) ? '--' : String(zoomLevel);
            el.textContent = 'Zoom: ' + z;
            updateDebugStats();
          }

          function updateZoomToast() {
            var el = document.getElementById('zoom-toast');
            if (!el || !map) { return; }
            var searchInput = document.getElementById('gpm-search-input');
            var isSearchFocused = (searchInput && document.activeElement === searchInput);
            if (isSearchFocused) {
              el.classList.remove('show');
              return;
            }
            if (showAllShapes) {
              el.classList.remove('show');
              return;
            }
            el.textContent = 'You MUST zoom in to level ' + MIN_SHAPE_ZOOM + ' to start seeing Shapes.';
            var z = map.getZoom();
            if (!isFinite(z) || z < MIN_SHAPE_ZOOM) {
              el.classList.add('show');
            } else {
              el.classList.remove('show');
            }
          }

          function getRenderedShapeCount() {
            if (!map) { return 0; }
            var seenShapeIds = {};
            var count = 0;
            map.data.forEach(function (feature) {
              var sid = feature.getProperty('shapeRecordId');
              var key = sid ? String(sid) : null;
              if (!key) {
                // Count no-id features individually; they cannot be reliably deduped.
                count++;
                return;
              }
              if (seenShapeIds[key] === true) {
                return;
              }
              seenShapeIds[key] = true;
              count++;
            });
            return count;
          }

          function updateDebugStats(candidateCount) {
            var el = document.getElementById('debug-stats');
            if (!el) { return; }
            var candidates = (candidateCount === null || candidateCount === undefined) ? '--' : String(candidateCount);
            el.textContent = 'Visible Shapes: ' + getRenderedShapeCount() + ' | Available Shapes: ' + candidates;
          }

          function applyShapeDataStyle() {
            if (!map) { return; }
            map.data.setStyle(function (feature) {
              var color = normalizeHexColor(feature.getProperty('color')) || '#2EC223';
              if (hoverFeature && feature === hoverFeature) {
                return {
                  fillColor: color,
                  fillOpacity: 0.58,
                  strokeColor: color,
                  strokeWeight: 2.4,
                  zIndex: 1000
                };
              }
              return {
                fillColor: color,
                fillOpacity: 0.35,
                strokeColor: color,
                strokeWeight: 1
              };
            });
          }

          function getUniqueCandidateCount(specs) {
            if (!specs || !specs.length) { return 0; }
            var seen = {};
            var count = 0;
            for (var i = 0; i < specs.length; i++) {
              var sid = specs[i] && specs[i].shapeRecordId ? String(specs[i].shapeRecordId) : null;
              if (!sid) {
                count++;
                continue;
              }
              if (seen[sid] === true) {
                continue;
              }
              seen[sid] = true;
              count++;
            }
            return count;
          }

          function getViewportBoundsBox() {
            if (!map) { return null; }
            if (showAllShapes) {
              return {
                minLat: -85,
                maxLat: 85,
                minLng: -180,
                maxLng: 180
              };
            }
            var bounds = map.getBounds();
            if (!bounds) { return null; }
            var sw = bounds.getSouthWest();
            var ne = bounds.getNorthEast();
            return {
              minLat: sw.lat(),
              maxLat: ne.lat(),
              minLng: sw.lng(),
              maxLng: ne.lng()
            };
          }

          function featureIntersectsViewport(feature, viewport) {
            if (!feature || !viewport) { return true; }
            if (feature.properties) {
              var bMinLat = Number(feature.properties.bboxMinLat);
              var bMaxLat = Number(feature.properties.bboxMaxLat);
              var bMinLng = Number(feature.properties.bboxMinLng);
              var bMaxLng = Number(feature.properties.bboxMaxLng);
              if (isFinite(bMinLat) && isFinite(bMaxLat) && isFinite(bMinLng) && isFinite(bMaxLng)) {
                return (
                  bMaxLat >= viewport.minLat &&
                  bMinLat <= viewport.maxLat &&
                  bMaxLng >= viewport.minLng &&
                  bMinLng <= viewport.maxLng
                );
              }
            }
            if (feature.centroid && feature.centroid.coordinates && feature.centroid.coordinates.length >= 2) {
              var cLng = Number(feature.centroid.coordinates[0]);
              var cLat = Number(feature.centroid.coordinates[1]);
              if (isFinite(cLat) && isFinite(cLng)) {
                return (
                  cLat >= viewport.minLat &&
                  cLat <= viewport.maxLat &&
                  cLng >= viewport.minLng &&
                  cLng <= viewport.maxLng
                );
              }
            }
            return true;
          }

          function pruneFeaturesToViewport(specs) {
            var visibleIds = {};
            for (var i = 0; i < specs.length; i++) {
              var sid = specs[i] && specs[i].shapeRecordId ? String(specs[i].shapeRecordId) : null;
              if (sid) {
                visibleIds[sid] = true;
              }
            }

            var toRemove = [];
            map.data.forEach(function (feature) {
              var sid = feature.getProperty('shapeRecordId');
              var key = sid ? String(sid) : null;
              if (!key || visibleIds[key] !== true) {
                toRemove.push(feature);
                if (key) {
                  delete loadedShapeIds[key];
                  delete pendingShapeIds[key];
                }
              }
            });
            for (var j = 0; j < toRemove.length; j++) {
              map.data.remove(toRemove[j]);
            }
            dedupeRenderedFeaturesByShapeId();
            pruneRenderedFeaturesToViewport();
            updateDebugStats(getUniqueCandidateCount(specs));
          }

          function dedupeRenderedFeaturesByShapeId() {
            if (!map) { return; }
            var seen = {};
            var toRemove = [];
            map.data.forEach(function (feature) {
              var sid = feature.getProperty('shapeRecordId');
              var key = sid ? String(sid) : null;
              if (!key) {
                return;
              }
              if (seen[key] === true) {
                toRemove.push(feature);
                return;
              }
              seen[key] = true;
            });
            for (var i = 0; i < toRemove.length; i++) {
              map.data.remove(toRemove[i]);
            }
          }

          function pruneRenderedFeaturesToViewport() {
            if (showAllShapes) {
              return;
            }
            var viewport = getViewportBoundsBox();
            if (!viewport) { return; }
            var toRemove = [];
            map.data.forEach(function (feature) {
              var bboxMinLat = Number(feature.getProperty('bboxMinLat'));
              var bboxMaxLat = Number(feature.getProperty('bboxMaxLat'));
              var bboxMinLng = Number(feature.getProperty('bboxMinLng'));
              var bboxMaxLng = Number(feature.getProperty('bboxMaxLng'));
              if (
                isFinite(bboxMinLat) && isFinite(bboxMaxLat) &&
                isFinite(bboxMinLng) && isFinite(bboxMaxLng)
              ) {
                var intersects = (
                  bboxMaxLat >= viewport.minLat &&
                  bboxMinLat <= viewport.maxLat &&
                  bboxMaxLng >= viewport.minLng &&
                  bboxMinLng <= viewport.maxLng
                );
                if (!intersects) {
                  toRemove.push(feature);
                }
              }
            });
            for (var i = 0; i < toRemove.length; i++) {
              var sid = toRemove[i].getProperty('shapeRecordId');
              if (sid) {
                delete loadedShapeIds[String(sid)];
                delete pendingShapeIds[String(sid)];
              }
              map.data.remove(toRemove[i]);
            }
            updateDebugStats();
          }

          function parseJsonSafe(s) {
            try { return JSON.parse(s); } catch (e) { return null; }
          }

          function invokeRemote(action /*, ...args */) {
            var args = Array.prototype.slice.call(arguments, 1);
            return new Promise(function (resolve, reject) {
              args.push(function (result, event) {
                if (event && event.status === true) {
                  resolve(result);
                } else {
                  reject(new Error((event && event.message) || 'Remote action failed'));
                }
              });
              args.push({ escape: false, buffer: false, timeout: 120000 });
              Visualforce.remoting.Manager.invokeAction.apply(Visualforce.remoting.Manager, [action].concat(args));
            });
          }

          function normalizeHexColor(value) {
            if (!value) { return null; }
            var s = String(value).trim();
            if (!s) { return null; }
            if (s.charAt(0) === '#') { s = s.substring(1); }
            if (!/^[0-9a-fA-F]{6}$/.test(s)) { return null; }
            return '#' + s.toUpperCase();
          }

          function clearLabelMarkers() {
            for (var i = 0; i < labelMarkers.length; i++) {
              labelMarkers[i].setMap(null);
            }
            labelMarkers = [];
          }

          function getLabelFontSize() {
            if (!map) { return '11px'; }
            var z = Number(map.getZoom());
            if (!isFinite(z)) { return '11px'; }
            if (z >= 12) { return '17px'; }
            if (z >= 10) { return '15px'; }
            if (z >= 8) { return '13px'; }
            return '11px';
          }

          function renderShapeLabels() {
            clearLabelMarkers();
            var labelFontSize = getLabelFontSize();
            map.data.forEach(function (feature) {
              var name = feature.getProperty('name');
              var lat = Number(feature.getProperty('centroidLat'));
              var lng = Number(feature.getProperty('centroidLng'));
              if (!name || !isFinite(lat) || !isFinite(lng)) {
                return;
              }
              var marker = new google.maps.Marker({
                map: map,
                position: { lat: lat, lng: lng },
                icon: {
                  path: google.maps.SymbolPath.CIRCLE,
                  scale: 0,
                  fillOpacity: 0,
                  strokeOpacity: 0
                },
                clickable: false,
                label: {
                  text: String(name),
                  color: '#1F2937',
                  fontSize: labelFontSize,
                  fontWeight: '600'
                }
              });
              labelMarkers.push(marker);
            });
          }

          function gpmSetClientError(message) {
            var el = document.getElementById('gpm-client-error');
            if (!el) {
              return;
            }
            if (!message) {
              el.style.display = 'none';
              el.textContent = '';
              return;
            }
            el.textContent = String(message);
            el.style.display = 'block';
          }

          function gpmDebug(eventName, payload) {
            if (window.GPM_SEARCH_DEBUG !== true) {
              return;
            }
            if (!window.console || !console.log) {
              return;
            }
            var ts = (new Date()).toISOString();
            if (payload === undefined) {
              console.log('[GPM Search][' + ts + '] ' + eventName);
            } else {
              console.log('[GPM Search][' + ts + '] ' + eventName, payload);
            }
          }

          function gpmFocusPlaceOnMap(mapRef, place) {
            if (!place || !place.geometry) {
              gpmDebug('focus.skipped', { reason: 'missing_geometry', place: place || null });
              return false;
            }
            if (place.geometry.viewport) {
              mapRef.fitBounds(place.geometry.viewport);
              gpmDebug('focus.viewport', {
                placeName: place.name || '',
                formattedAddress: place.formatted_address || ''
              });
            } else if (place.geometry.location) {
              mapRef.setCenter(place.geometry.location);
              mapRef.setZoom(12);
              gpmDebug('focus.location', {
                placeName: place.name || '',
                formattedAddress: place.formatted_address || '',
                lat: place.geometry.location.lat ? place.geometry.location.lat() : null,
                lng: place.geometry.location.lng ? place.geometry.location.lng() : null
              });
            } else {
              gpmDebug('focus.skipped', { reason: 'missing_viewport_and_location' });
              return false;
            }
            return true;
          }

          function gpmInitUnifiedSearch(mapRef) {
            if (!mapRef) { return; }
            var input = document.getElementById('gpm-search-input');
            var searchBtn = document.getElementById('gpm-search-button');
            if (!input || !searchBtn) { return; }
            input.setAttribute('autocomplete', 'off');
            var selectedPlace = null;
            var autocomplete = null;

            function initStandardAutocomplete() {
              if (!(google && google.maps && google.maps.places && google.maps.places.Autocomplete)) {
                gpmSetClientError('Places autocomplete failed to initialize.');
                return;
              }
              autocomplete = new google.maps.places.Autocomplete(input, {
                types: ['geocode', 'establishment'],
                componentRestrictions: { country: 'us' }
              });
              autocomplete.bindTo('bounds', mapRef);
              autocomplete.addListener('place_changed', function () {
                selectedPlace = autocomplete.getPlace();
                if (!selectedPlace || !selectedPlace.geometry || !selectedPlace.geometry.location) {
                  return;
                }
                gpmSetClientError('');
                gpmFocusPlaceOnMap(mapRef, selectedPlace);
              });
            }

            if (google && google.maps && typeof google.maps.importLibrary === 'function') {
              google.maps.importLibrary('places')
                .then(function () {
                  initStandardAutocomplete();
                })
                .catch(function () {
                  gpmSetClientError('Places failed to load for this API key/domain.');
                });
            } else {
              initStandardAutocomplete();
            }

            input.addEventListener('focus', function () {
              updateZoomToast();
            });
            input.addEventListener('blur', function () {
              window.setTimeout(updateZoomToast, 100);
            });

            function applyPlacesQuery(query) {
              if (!(google && google.maps && google.maps.places && google.maps.places.PlacesService)) {
                gpmSetClientError('Places is still loading. Please try again.');
                return;
              }
              var service = new google.maps.places.PlacesService(mapRef);
              service.textSearch(
                {
                  query: query,
                  fields: ['name', 'geometry', 'formatted_address'],
                  locationBias: mapRef.getCenter(),
                  region: 'us'
                },
                function (results, status) {
                  if (status !== google.maps.places.PlacesServiceStatus.OK || !results || results.length === 0) {
                    gpmSetClientError('No location found for: ' + query);
                    return;
                  }
                  var place = results[0];
                  if (!place.geometry || !place.geometry.location) {
                    gpmSetClientError('No geometry returned for: ' + query);
                    return;
                  }
                  gpmSetClientError('');
                  gpmFocusPlaceOnMap(mapRef, place);
                }
              );
            }

            function runUnifiedSearch() {
              var query = input.value ? String(input.value).trim() : '';
              if (!query) {
                return;
              }
              if (selectedPlace && selectedPlace.geometry && selectedPlace.geometry.location) {
                gpmSetClientError('');
                gpmFocusPlaceOnMap(mapRef, selectedPlace);
                return;
              }
              applyPlacesQuery(query);
            }

            input.addEventListener('input', function () {
              selectedPlace = null;
            });
            searchBtn.addEventListener('click', function () {
              runUnifiedSearch();
            });
            input.addEventListener('keypress', function (event) {
              if (event && event.key === 'Enter') {
                event.preventDefault();
                runUnifiedSearch();
              }
            });
          }

          function splitSpecsIntoBatches(specs, batchSize) {
            var out = [];
            if (!specs || !specs.length) { return out; }
            var size = Math.max(1, batchSize || BATCH_SIZE);
            for (var i = 0; i < specs.length; i += size) {
              out.push(specs.slice(i, i + size));
            }
            return out;
          }

          async function fetchFeaturesForBatch(specBatch) {
            if (!specBatch || !specBatch.length) {
              return { features: [], loadedCount: 0, errorCount: 0 };
            }
            var raw = await invokeRemote(
              '{!$RemoteAction.PSM_MapController.getDissolvedShapeGeometryBatch}',
              JSON.stringify(specBatch)
            );
            var batchResult = (typeof raw === 'string') ? parseJsonSafe(raw) : raw;
            if (!batchResult || batchResult.success !== true) {
              return { features: [], loadedCount: 0, errorCount: 1 };
            }
            return {
              features: batchResult.features || [],
              loadedCount: Number(batchResult.loadedCount || 0),
              errorCount: Number(batchResult.errorCount || 0)
            };
          }

          async function loadFeaturesInBatches(specs) {
            var batches = splitSpecsIntoBatches(specs, BATCH_SIZE);
            if (!batches.length) {
              return { loaded: 0, batchErrors: 0 };
            }
            var nextIdx = 0;
            var loaded = 0;
            var batchErrors = 0;
            var workers = Math.max(1, BATCH_WORKERS);
            async function worker() {
              while (true) {
                var idx = nextIdx++;
                if (idx >= batches.length) { break; }
                var result = await fetchFeaturesForBatch(batches[idx]);
                if (result.features && result.features.length) {
                  map.data.addGeoJson({ type: 'FeatureCollection', features: result.features });
                }
                loaded += result.loadedCount || 0;
                batchErrors += result.errorCount || 0;
              }
            }
            var promises = [];
            for (var i = 0; i < workers; i++) {
              promises.push(worker());
            }
            await Promise.all(promises);
            return { loaded: loaded, batchErrors: batchErrors };
          }

